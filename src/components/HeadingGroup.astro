---
const { class: className, heading, subheading, body } = Astro.props;
---

<hgroup
  class:list={[
    className,
    "flex flex-col gap-1 text-pretty after:mt-4 after:h-0.5 after:w-20 after:rounded-sm after:bg-primary-dark",
  ]}>
  <h1 class="font-exteded text-3xl tracking-tight">
    {heading}
  </h1>

  {
    subheading && (
      <h2 class="font-mono text-lg tracking-tighter text-pretty text-muted">
        {subheading}
      </h2>
    )
  }

  {body && <p class="text-lg">{body}</p>}
</hgroup>
